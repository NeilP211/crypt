# CLIP embedding service. Build context is the repo root.
# The CLIP model is downloaded on first request, not baked into the image.

FROM python:3.11-slim
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc \
    && rm -rf /var/lib/apt/lists/*

COPY ingestion/pyproject.toml ./
COPY ingestion/crypt_ingest ./crypt_ingest
RUN pip install --no-cache-dir .

EXPOSE 8000
CMD ["uvicorn", "crypt_ingest.embed_service:app", "--host", "0.0.0.0", "--port", "8000"]
